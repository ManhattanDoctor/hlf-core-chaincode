{
    "name": "@hlf-core/chaincode",
    "version": "3.6.6",
    "description": "TypeScript library for developing Hyperledger Fabric chaincode with ORM-like entity management, relations, pagination and automatic validation",
    "main": "./cjs/public-api.js",
    "module": "./esm/public-api.js",
    "types": "./esm/public-api.d.ts",
    "exports": {
        ".": {
            "import": "./esm/public-api.js",
            "require": "./cjs/public-api.js",
            "types": "./esm/public-api.d.ts"
        }
    },
    "author": {
        "name": "Renat Gubaev",
        "email": "renat.gubaev@gmail.com"
    },
    "license": "ISC",
    "dependencies": {
        "@hlf-core/common": "~3.2.7",
        "@ts-core/common": "~3.0.56",
        "fabric-shim": "2.5.1",
        "reflect-metadata": "~0.1.13"
    },
    "devDependencies": {
        "gulp-npm-module-publisher": "^3.0.6"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ManhattanDoctor/hlf-core-chaincode.git"
    },
    "keywords": [
        "hyperledger",
        "hyperledger-fabric",
        "fabric",
        "chaincode",
        "smart-contracts",
        "blockchain",
        "distributed-ledger",
        "entity-management",
        "orm",
        "typescript"
    ],
    "bugs": {
        "url": "https://github.com/ManhattanDoctor/hlf-core-chaincode/issues"
    },
    "homepage": "https://hlf.gnosisai.ru/docs/packages/chaincode",
    "engines": {
        "node": ">=14.0.0"
    },
    "files": [
        "cjs",
        "esm",
        "dist",
        "README.md",
        "LICENSE"
    ]
}
